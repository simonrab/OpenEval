# Server API key. Send as: Authorization: Bearer <key>
# Never commit a real secret.
# Customer provider keys (POST /v1/keys) are encrypted at rest with a
# wrap key derived from this value (HKDF + AES-256-GCM). Do not read
# OPENROUTER_API_KEY from the server env as the customer key.
EVALROUTER_KEY=

# SQLite file path. Created on boot if missing.
EVALROUTER_SQLITE=data/evalrouter.sqlite

# Used if EVALROUTER_SQLITE is unset. Default: data
# DATA_DIR=data

# HTTP listen port. Use 0 for an ephemeral port.
PORT=3000
